{
  "name": "workflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-product.mjs",
    "build:vercel-static": "node scripts/build-product.mjs --vercel-static",
    "build:pages": "node scripts/build-pages.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:pages": "playwright test --config playwright.pages.config.ts",
    "test:e2e:vercel-static": "playwright test --config playwright.vercel-static.config.ts",
    "qa:devices": "npm run build && npm run test:e2e",
    "visual-story:build": "node scripts/build-workflow-visual-story.mjs",
    "visual-story:validate": "node qa/validate-visual-story.mjs --root . --manifest public/story-v3/manifest.json",
    "build:public-mirror": "node scripts/build-public-mirror.mjs",
    "test:public-mirror": "node scripts/http-mirror-smoke.mjs",
    "security:secrets": "node scripts/secret-guard.mjs . .next",
    "security:mirror": "node scripts/secret-guard.mjs public-mirror",
    "security:pages": "node scripts/secret-guard.mjs out",
    "security:vercel-static": "node scripts/secret-guard.mjs out",
    "test:pages-artifact": "node scripts/pages-artifact-gate.mjs",
    "test:vercel-artifact": "node scripts/pages-artifact-gate.mjs --target=vercel",
    "quality": "npm run lint && npm test && npm run visual-story:validate && npm run build && npm run test:e2e && npm run build:vercel-static && npm run test:vercel-artifact && npm run security:vercel-static && npm run test:e2e:vercel-static && npm run build:pages && npm run test:pages-artifact && npm run security:pages && npm run test:e2e:pages && npm run build:public-mirror && npm run test:public-mirror && npm run security:secrets && npm run security:mirror"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.23.0",
    "mammoth": "^1.12.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
