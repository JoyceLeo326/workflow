# Fail-closed default: the project owner is never billed automatically.
COST_MODE=zero_owner_cost

# OPENAI_API_KEY is ignored unless ownership is explicitly user or institution
# and an authoritative, unexpired quota snapshot is supplied.
AI_PROVIDER_OWNERSHIP=none
AI_PROVIDER_QUOTA_LIMIT=
AI_PROVIDER_QUOTA_USED=
AI_PROVIDER_QUOTA_RESET_AT=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat
